{
  "_about": "Hosts the console offers when adding a model provider, and published prices for hosts whose model list has none (OpenRouter's list carries its own). Prices are USD per million tokens, standard tier, prompts up to 200k tokens; image models price their image output as output tokens. An operator's price in config always wins, and a model not listed here stays 'unknown'. 'image_input' names the chat models of that family that accept pictures as input (the families' own docs), for lists that do not say so (OpenAI's and Gemini's list names only); the vision budget uses it, and a model not named stays 'unknown', never 'no'. Update the date and numbers together.",
  "hosts": [
    {
      "api": "openrouter",
      "id": "openrouter",
      "name": "OpenRouter",
      "base_url": "https://openrouter.ai/api/v1",
      "key_env": "MASAMONG_OPENROUTER_KEY",
      "key_url": "https://openrouter.ai/settings/keys",
      "batch": {"style": "inline", "kinds": ["chat", "embed"], "max_items": 10000, "discount": 0.5}
    },
    {
      "api": "gemini",
      "id": "gemini",
      "name": "Google Gemini",
      "base_url": "https://generativelanguage.googleapis.com/v1beta/openai",
      "key_env": "MASAMONG_GEMINI_KEY",
      "key_url": "https://aistudio.google.com/apikey",
      "batch": {"style": "gemini_files", "kinds": ["chat", "embed"], "max_items": 10000, "discount": 0.5}
    },
    {
      "api": "openai",
      "id": "openai",
      "name": "OpenAI",
      "base_url": "https://api.openai.com/v1",
      "key_env": "MASAMONG_OPENAI_KEY",
      "key_url": "https://platform.openai.com/api-keys",
      "batch": {"style": "openai_files", "kinds": ["chat", "embed"], "max_items": 50000, "max_inputs": 50000, "discount": 0.5}
