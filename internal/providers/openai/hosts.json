    {
      "api": "anthropic",
      "id": "anthropic",
      "name": "Anthropic",
      "base_url": "https://api.anthropic.com/v1",
      "key_env": "MASAMONG_ANTHROPIC_KEY",
      "key_url": "https://platform.claude.com/settings/keys",
      "batch": {"style": "anthropic", "kinds": ["chat"], "max_items": 100000, "discount": 0.5}
    },
    {
      "api": "compatible",
      "id": "cometapi",
      "name": "CometAPI",
      "base_url": "https://api.cometapi.com/v1",
      "key_env": "MASAMONG_COMETAPI_KEY",
      "key_url": "https://www.cometapi.com/console/token",
      "rerank": false
    },
    {
      "api": "compatible",
      "id": "nanogpt",
      "name": "NanoGPT",
      "base_url": "https://nano-gpt.com/api/v1",
      "key_env": "MASAMONG_NANOGPT_KEY",
      "key_url": "https://nano-gpt.com/api",
      "rerank": false,
      "batch": {"style": "openai_files", "base_url": "https://api.nano-gpt.com/api/v1", "kinds": ["chat"], "max_items": 10000, "require_max_tokens": true, "discount": 0.5}
    },
    {
      "api": "compatible",
      "id": "opengateway",
      "name": "OpenGateway",
      "base_url": "https://apis.opengateway.ai/v1",
      "key_env": "MASAMONG_OPENGATEWAY_KEY",
      "key_url": "https://opengateway.ai/dashboard",
      "rerank": false
    }
  ],
