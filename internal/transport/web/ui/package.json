{
  "name": "masamong-console",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/run-python.mjs scripts/strings.py && node scripts/i18n-check.mjs && npm run test:i18n && vite build && node scripts/postbuild.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test:i18n": "node --test scripts/*.test.mjs",
    "assets": "node scripts/run-python.mjs scripts/assets.py"
  },
  "devDependencies": {
    "@lucide/svelte": "1.47.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tsconfig/svelte": "5.0.8",
    "pretendard": "1.3.9",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  }
}
