{
  "_about": "Tool regression set (docs/plan-memory-conversation.md §7, first row), English half. Same failure types as tools_regression_ko.json, written for this file. Keys: see tools_regression_ko.json.",
  "locale": "en",
  "speaker": "Ann",
  "sample": "sample-en.csv",
  "enable_tools": ["web.read"],
  "forbid_in_every_answer": ["tool_plan", "\"parameters\"", "<memory>", "<tool_results>", "untrusted_data", "assumed_region", "as an AI language model"],
  "scenarios": [
    {"id": "fortune_chat", "category": "command_only", "turns": ["can you read my horoscope for today?"], "expect_tools": ["help.version"], "forbid_tools": ["search.web"]},
    {"id": "used_iphone", "category": "used_goods", "turns": ["How much is a used iPhone 15 going for?"], "forbid_tools": ["finance.quote"], "expect_tools": ["search.web"]},
    {"id": "used_switch", "category": "used_goods", "turns": ["What's a fair price for a second-hand Nintendo Switch?"], "forbid_tools": ["finance.quote"], "expect_tools": ["search.web"]},
    {"id": "used_galaxy", "category": "used_goods", "turns": ["How much could I sell my old Galaxy S24 for?"], "forbid_tools": ["finance.quote"]},
    {"id": "macbook_price", "category": "used_goods", "turns": ["How much does a MacBook Air M3 cost these days?"], "forbid_tools": ["finance.quote"], "expect_tools": ["search.web"]},
    {"id": "number_only", "category": "used_goods", "turns": ["35 bucks is cheap, right?"], "forbid_tools": ["finance.quote", "finance.fx"]},

    {"id": "busan_rain", "category": "weather_context", "turns": ["I'm heading to Busan this week", "Will it rain tomorrow?"], "expect_tools": ["weather.query"], "params": {"weather.query": {"region": "Busan", "day_offset": "1"}}},
    {"id": "london_umbrella", "category": "weather_context", "turns": ["Flying to London next Monday, so excited", "Should I pack an umbrella?"], "expect_tools": ["weather.query"], "params": {"weather.query": {"region": "London"}}},
    {"id": "tokyo_clothes", "category": "weather_context", "turns": ["Business trip to Tokyo the day after tomorrow", "What's the weather like there? What should I wear?"], "expect_tools": ["weather.query"], "params": {"weather.query": {"region": "Tokyo"}}},
    {"id": "madrid_hot", "category": "weather_context", "turns": ["I live in Madrid and it's been so hot", "How warm is it today?"], "expect_tools": ["weather.query"], "params": {"weather.query": {"region": "Madrid"}}},
    {"id": "nyc_weekend", "category": "weather_context", "turns": ["Let's do Central Park this weekend", "Is the weekend weather any good in New York?"], "expect_tools": ["weather.query"], "params": {"weather.query": {"region": "New York"}}},

    {"id": "weather_no_area", "category": "weather_default", "turns": ["How's the weather today?"], "expect_tools": ["weather.query"], "answer_any": ["Seoul"]},
    {"id": "umbrella_no_area", "category": "weather_default", "turns": ["Do I need an umbrella today?"], "expect_tools": ["weather.query"], "answer_any": ["Seoul"]},
    {"id": "tomorrow_cold", "category": "weather_default", "turns": ["Is it going to be cold tomorrow?"], "expect_tools": ["weather.query"], "answer_any": ["Seoul"]},

    {"id": "food_no_area", "category": "ask_area", "turns": ["Recommend a good restaurant"], "expect_ask": true, "forbid_tools": ["places.search"]},
    {"id": "cafe_no_area", "category": "ask_area", "turns": ["Know a cozy cafe?"], "expect_ask": true, "forbid_tools": ["places.search"]},
    {"id": "dinner_no_area", "category": "ask_area", "turns": ["Find me somewhere nearby for dinner tonight"], "expect_ask": true, "forbid_tools": ["places.search"]},
    {"id": "food_area_later", "category": "ask_area", "turns": ["Meeting friends around Hongdae later", "Any good food spots there?"], "expect_tools": ["places.search"], "params": {"places.search": {"query": "Hongdae"}}},
    {"id": "food_area", "category": "ask_area", "turns": ["Brunch places in Seongsu?"], "expect_tools": ["places.search"], "params": {"places.search": {"query": "Seongsu"}}},

    {"id": "link_what", "category": "link", "turns": ["What's this about? https://example.com/"], "expect_tools": ["web.read"], "params": {"web.read": {"url": "example.com"}}},
    {"id": "link_summary", "category": "link", "turns": ["Summarize this for me https://www.iana.org/help/example-domains"], "expect_tools": ["web.read"]},
    {"id": "link_question", "category": "link", "turns": ["https://en.wikipedia.org/wiki/Seoul what population does this page give?"], "expect_tools": ["web.read"]},
    {"id": "link_no_question", "category": "link", "turns": ["lol look at this https://example.com/meme"], "forbid_tools": ["search.web"]},

    {"id": "fx_down", "category": "fallback", "turns": ["What's the dollar to won rate right now?"], "fail_tools": ["finance.fx"], "expect_tools": ["search.web"]},
    {"id": "fx_down_yen", "category": "fallback", "turns": ["How much is the yen worth in dollars?"], "fail_tools": ["finance.fx"], "expect_tools": ["search.web"]},
