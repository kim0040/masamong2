    {"id": "joke", "category": "small_talk", "turns": ["Tell me a dad joke"], "no_tool": true},
    {"id": "about_bot", "category": "small_talk", "turns": ["Who made you?"], "no_tool": true},
    {"id": "opinion", "category": "small_talk", "turns": ["Pineapple on pizza: yes or no?"], "no_tool": true},

    {"id": "define_photosynthesis", "category": "no_tool_knowledge", "turns": ["What is photosynthesis?"], "no_tool": true, "answer_any": ["light", "energy", "carbon"]},
    {"id": "define_word", "category": "no_tool_knowledge", "turns": ["What does 'paradox' mean?"], "no_tool": true},
    {"id": "math_percent", "category": "no_tool_knowledge", "turns": ["What's 15% of 48?"], "no_tool": true, "answer_any": ["7.2"]},
