-- table activity_counts on activity_counts
CREATE TABLE activity_counts (
		day TEXT NOT NULL,
		guild_id TEXT NOT NULL,
		channel_id TEXT NOT NULL,
		user_id TEXT NOT NULL,
		name TEXT NOT NULL DEFAULT '',
		n INTEGER NOT NULL DEFAULT 0,
		last_at TEXT NOT NULL,
		PRIMARY KEY (day, guild_id, channel_id, user_id)
	)
-- table admin_state on admin_state
CREATE TABLE admin_state (
		k TEXT PRIMARY KEY,
		v TEXT NOT NULL,
		updated_at TEXT NOT NULL
	)
-- table audit_log on audit_log
CREATE TABLE audit_log (
		id INTEGER PRIMARY KEY AUTOINCREMENT,
		at TEXT NOT NULL,
		action TEXT NOT NULL,
		via TEXT NOT NULL,
		ok INTEGER NOT NULL,
		code TEXT NOT NULL DEFAULT '',
		rev_before INTEGER NOT NULL DEFAULT 0,
		rev_after INTEGER NOT NULL DEFAULT 0,
		summary TEXT NOT NULL DEFAULT '',
		actor TEXT NOT NULL DEFAULT ''
	, actor_id TEXT NOT NULL DEFAULT '', guild_id TEXT NOT NULL DEFAULT '')
-- table banter_channel_state on banter_channel_state
CREATE TABLE banter_channel_state (
			guild_id TEXT NOT NULL,
			channel_id TEXT NOT NULL,
			lines TEXT NOT NULL DEFAULT '[]',
			emoji TEXT NOT NULL DEFAULT '[]',
			muted_until TEXT NOT NULL DEFAULT '',
			PRIMARY KEY(guild_id, channel_id)
		)
-- table banter_turns on banter_turns
CREATE TABLE banter_turns (
			turn_id TEXT PRIMARY KEY,
			guild_id TEXT NOT NULL,
			channel_id TEXT NOT NULL,
			created_at TEXT NOT NULL
		)
-- table channel_episode on channel_episode
CREATE TABLE channel_episode (
		id TEXT PRIMARY KEY,
		guild_id TEXT NOT NULL,
		channel_id TEXT NOT NULL,
		room TEXT NOT NULL,
		kind TEXT NOT NULL,
		title TEXT NOT NULL,
		status TEXT NOT NULL,
		due_at TEXT NOT NULL DEFAULT '',
		when_text TEXT NOT NULL DEFAULT '',
		importance INTEGER NOT NULL DEFAULT 2,
		source TEXT NOT NULL,
		participants TEXT NOT NULL DEFAULT '[]',
		segment TEXT NOT NULL DEFAULT '[]',
		first_seen TEXT NOT NULL,
		last_seen TEXT NOT NULL,
		expires_at TEXT NOT NULL DEFAULT '',
		supersedes_id TEXT NOT NULL DEFAULT '',
		regen INTEGER NOT NULL DEFAULT 0,
		updated_at TEXT NOT NULL,
		revision INTEGER NOT NULL DEFAULT 1
	)
-- table channel_ops_log on channel_ops_log
CREATE TABLE channel_ops_log (
			id INTEGER PRIMARY KEY AUTOINCREMENT,
			guild_id TEXT NOT NULL,
			channel_id TEXT NOT NULL,
			kind TEXT NOT NULL,
			summary TEXT NOT NULL,
			revision INTEGER,
			created_at TEXT NOT NULL
		)
-- table channel_state on channel_state
CREATE TABLE channel_state (
		guild_id TEXT NOT NULL,
		channel_id TEXT NOT NULL,
		room TEXT NOT NULL,
		body TEXT NOT NULL,
		evidence TEXT NOT NULL,
		anchor_observation TEXT NOT NULL DEFAULT '',
		anchor_time TEXT NOT NULL DEFAULT '',
		revision INTEGER NOT NULL DEFAULT 1,
		updated_n INTEGER NOT NULL DEFAULT 0,
		updated_at TEXT NOT NULL,
		PRIMARY KEY(guild_id, channel_id)
	)
-- table channel_style on channel_style
CREATE TABLE channel_style (
		guild_id TEXT NOT NULL,
		channel_id TEXT NOT NULL,
		version INTEGER NOT NULL,
		state TEXT NOT NULL,
		stats TEXT NOT NULL DEFAULT '{}',
		items TEXT NOT NULL DEFAULT '[]',
		note TEXT NOT NULL DEFAULT '',
		messages INTEGER NOT NULL DEFAULT 0,
		cost_usd REAL NOT NULL DEFAULT 0,
		created_at TEXT NOT NULL,
		decided_at TEXT NOT NULL DEFAULT '',
		PRIMARY KEY (guild_id, channel_id, version))
-- table channel_summary on channel_summary
CREATE TABLE channel_summary (
		guild_id TEXT NOT NULL,
		channel_id TEXT NOT NULL,
		anchor_observation TEXT NOT NULL,
		anchor_time TEXT NOT NULL,
		summary TEXT NOT NULL,
		messages INTEGER NOT NULL DEFAULT 0,
		updated_at TEXT NOT NULL, evidence_state INTEGER NOT NULL DEFAULT 0,
		PRIMARY KEY(guild_id, channel_id)
	)
-- table channel_threads on channel_threads
CREATE TABLE channel_threads (
		thread_id TEXT PRIMARY KEY,
		guild_id TEXT NOT NULL,
		parent_id TEXT NOT NULL,
		bot_owned INTEGER NOT NULL DEFAULT 0,
		owner_id TEXT NOT NULL DEFAULT '',
		origin_turn TEXT NOT NULL DEFAULT '',
		state TEXT NOT NULL DEFAULT 'open',
		created_at TEXT NOT NULL,
		last_at TEXT NOT NULL,
