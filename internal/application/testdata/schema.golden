-- trigger evidence_links_cleanup on evidence_links
CREATE TRIGGER evidence_links_cleanup AFTER DELETE ON evidence_links BEGIN
			 DELETE FROM evidence_sources WHERE id=OLD.source AND NOT EXISTS(SELECT 1 FROM evidence_links WHERE source=OLD.source);
			 DELETE FROM evidence_holders WHERE id=OLD.holder AND NOT EXISTS(SELECT 1 FROM evidence_links WHERE holder=OLD.holder);
			 END
-- trigger evidence_refs_delete on evidence_refs
CREATE TRIGGER evidence_refs_delete INSTEAD OF DELETE ON evidence_refs BEGIN
			 DELETE FROM evidence_links WHERE source=(SELECT id FROM evidence_sources WHERE source_id=OLD.source_id) AND holder=(SELECT id FROM evidence_holders WHERE holder_kind=OLD.holder_kind AND holder_id=OLD.holder_id);
			 END
-- trigger evidence_refs_insert on evidence_refs
CREATE TRIGGER evidence_refs_insert INSTEAD OF INSERT ON evidence_refs BEGIN
			 INSERT OR IGNORE INTO evidence_sources(source_id) VALUES(NEW.source_id);
			 INSERT OR IGNORE INTO evidence_holders(holder_kind,holder_id) VALUES(NEW.holder_kind,NEW.holder_id);
			 INSERT OR IGNORE INTO evidence_links(source,holder) SELECT s.id,h.id FROM evidence_sources s,evidence_holders h WHERE s.source_id=NEW.source_id AND h.holder_kind=NEW.holder_kind AND h.holder_id=NEW.holder_id;
			 END
-- trigger memory_leaf_sync_delete on memory_leaves
CREATE TRIGGER memory_leaf_sync_delete AFTER DELETE ON memory_leaves BEGIN
			UPDATE memory_leaf_sync SET valid=0 WHERE room=OLD.room AND valid=1; END
-- trigger memory_leaf_sync_insert on memory_leaves
CREATE TRIGGER memory_leaf_sync_insert AFTER INSERT ON memory_leaves BEGIN
			UPDATE memory_leaf_sync SET valid=0 WHERE room=NEW.room AND valid=1; END
-- trigger memory_leaf_sync_recipe on memory_rooms
CREATE TRIGGER memory_leaf_sync_recipe AFTER UPDATE OF active_recipe ON memory_rooms WHEN OLD.active_recipe<>NEW.active_recipe BEGIN
			UPDATE memory_leaf_sync SET valid=0 WHERE room=NEW.room AND valid=1; END
-- trigger memory_leaf_sync_update on memory_leaves
CREATE TRIGGER memory_leaf_sync_update AFTER UPDATE OF room,recipe,first_observation_id,observation_ids,n,body,body_hash,speakers,end_time,closed ON memory_leaves BEGIN
			UPDATE memory_leaf_sync SET valid=0 WHERE room IN (OLD.room,NEW.room) AND valid=1; END
-- trigger person_alias_delete on memory_observations
CREATE TRIGGER person_alias_delete AFTER DELETE ON memory_observations
			BEGIN DELETE FROM person_alias_source WHERE observation=old.observation_id; END
-- trigger person_alias_edit on memory_observations
CREATE TRIGGER person_alias_edit AFTER UPDATE OF deleted_at,edited_at,actor_label,actor_account,source_room,content ON memory_observations
			BEGIN DELETE FROM person_alias_source WHERE observation=old.observation_id; END
-- trigger person_alias_lost on person_alias_source
CREATE TRIGGER person_alias_lost AFTER DELETE ON person_alias_source BEGIN
			DELETE FROM person_alias WHERE (guild_id,person_ref,label,room)=(old.guild_id,old.person_ref,old.label,old.room)
			AND NOT EXISTS(SELECT 1 FROM person_alias_source WHERE (guild_id,person_ref,label,room)=(old.guild_id,old.person_ref,old.label,old.room));
			UPDATE person_alias SET first_seen=(SELECT at FROM person_alias_source WHERE
			(guild_id,person_ref,label,room)=(old.guild_id,old.person_ref,old.label,old.room) ORDER BY at LIMIT 1),
			(last_seen,last_source)=(SELECT at,observation FROM person_alias_source WHERE
			(guild_id,person_ref,label,room)=(old.guild_id,old.person_ref,old.label,old.room) ORDER BY at DESC,observation DESC LIMIT 1)
			WHERE (guild_id,person_ref,label,room)=(old.guild_id,old.person_ref,old.label,old.room); END
-- trigger person_alias_seen on person_alias_source
CREATE TRIGGER person_alias_seen AFTER INSERT ON person_alias_source BEGIN
			INSERT INTO person_alias(guild_id,person_ref,label,room,first_seen,last_seen,last_source,folded)
			VALUES(new.guild_id,new.person_ref,new.label,new.room,new.at,new.at,new.observation,new.folded)
			ON CONFLICT(guild_id,person_ref,label,room) DO UPDATE SET
			last_source=CASE WHEN (new.at,new.observation)>(last_seen,last_source) THEN new.observation ELSE last_source END,
			first_seen=min(first_seen,new.at),last_seen=max(last_seen,new.at); END
-- trigger privacy_settled_insert on privacy_tombstones
CREATE TRIGGER privacy_settled_insert AFTER INSERT ON privacy_tombstones BEGIN DELETE FROM privacy_settled WHERE source_id=NEW.source_id; END
-- trigger privacy_settled_update on privacy_tombstones
CREATE TRIGGER privacy_settled_update AFTER UPDATE ON privacy_tombstones BEGIN DELETE FROM privacy_settled WHERE source_id=NEW.source_id; END
-- view evidence_refs on evidence_refs
CREATE VIEW evidence_refs AS SELECT s.source_id,h.holder_kind,h.holder_id FROM evidence_links r JOIN evidence_sources s ON s.id=r.source JOIN evidence_holders h ON h.id=r.holder
