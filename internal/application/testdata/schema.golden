== pruneRules (21)
  0  turns table=turn_log column=at days=turns dayOnly=false extra=""
  1  traces table=traces column=created_at days=traces dayOnly=false extra=""
  2  audit table=audit_log column=at days=audit dayOnly=false extra=""
  3  channel_ops table=channel_ops_log column=created_at days=audit dayOnly=false extra=""
  4  usage_detail table=tool_usage column=day days=usage dayOnly=true extra="scope<>'all'"
  5  usage_totals table=tool_usage column=day days=turns dayOnly=true extra="scope='all'"
  6  query_cache table=memory_embed_cache column=created_at days=query_cache dayOnly=false extra="kind='query'"
  7  reminders table=reminders column=updated_at days=context dayOnly=false extra="status IN ('sent','cancelled','missed','failed','unknown')"
  8  reminders_stale table=reminders column=updated_at days=pending dayOnly=false extra="status='proposed'"
  9  reminder_offers table=reminder_offers column=expires_at days=pending dayOnly=false extra=""
