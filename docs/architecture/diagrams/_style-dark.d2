# Shared look of every diagram in this folder, dark version. scripts/diagrams.sh puts this file in
# front of each source, so a source only names the classes below. The light version is _style-light.d2.
vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 200
    pad: 16
  }
}
style.fill: transparent

classes: {
  actor: {
    style: {fill: "#292524"; stroke: "#a8a29e"; font-color: "#f5f5f4"; border-radius: 8}
  }
  entry: {
    style: {fill: "#172554"; stroke: "#60a5fa"; font-color: "#eff6ff"; border-radius: 8}
  }
  core: {
    style: {fill: "#43200a"; stroke: "#fb923c"; font-color: "#fff7ed"; border-radius: 8}
  }
  memory: {
    style: {fill: "#0f2e1b"; stroke: "#4ade80"; font-color: "#f0fdf4"; border-radius: 8}
  }
  external: {
    style: {fill: "#2a1b4a"; stroke: "#c4a1ff"; font-color: "#f5f3ff"; border-radius: 8}
  }
  store: {
    style: {fill: "#3a3632"; stroke: "#d6d3d1"; font-color: "#fafaf9"; border-radius: 8}
  }
  group: {
    style: {fill: "#161b22"; stroke: "#6e7681"; font-color: "#c9d1d9"; border-radius: 10; stroke-dash: 4; font-size: 20}
  }
  row: {
    style: {fill: transparent; stroke: transparent}
  }
  note: {
    style: {fill: transparent; stroke: transparent; font-color: "#a8a29e"}
  }
  flow: {
    style: {stroke: "#a8a29e"; font-color: "#d6d3d1"}
  }
  weak: {
    style: {stroke: "#78716c"; font-color: "#a8a29e"; stroke-dash: 4}
  }
}

# every connection, unless it names a class of its own
(** -> **)[*].style.stroke: "#a8a29e"
(** -> **)[*].style.font-color: "#d6d3d1"
(** <-> **)[*].style.stroke: "#a8a29e"
(** <-> **)[*].style.font-color: "#d6d3d1"
