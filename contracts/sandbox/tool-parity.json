  "ranking": {
    "R0": "hybrid",
    "R1": "heuristic",
    "R2": "rerank",
    "auto": "auto",
    "note": "검색 버전 이름은 tools/evaluation/rag_upgrade, 샌드박스 UI, Go 제품이 공유한다. Go 제품은 `internal/memory/search`에서 실행하고 샌드박스는 독립 로컬 인덱스와 비교·실험에 사용한다. R2 ≠ R0+R1. R2 `rerank`는 벤더 중립 이름이며 모델은 config.json models.rerank 로 바꾼다(옛 이름 `cohere`는 별칭). R1 `heuristic`은 ablation 전용이다 — `auto`는 어떤 경로에서도 R1로 내려가지 않는다(2026-09-17 퇴역). `auto`(v2)는 검색 전에 모드를 고르지 않는다: R0 v2 후보 풀을 만들고 관찰한 뒤 finish / rerank / recovery 를 정한다.",
    "auto_policy": {
      "kind": "cascade_v2",
      "on_high": "hybrid",
      "on_medium": "rerank",
      "on_low": "rerank",
      "no_rerank": "hybrid",
      "rerank_failed": "hybrid",
      "min_remaining_budget_usd": 0.02,
      "recovery_max_attempts": 1,
      "time_scoped_pool": "time_window",
      "thresholds": {
        "assess_top_n": 10,
        "high_agreement": 0.6,
        "high_margin": 0.15,
        "low_agreement": 0.2,
        "min_candidates": 3,
        "min_target_coverage": 0.3
      },
      "reasons": [
        "r0_confident",
        "rerank_uncertain",
        "rerank_low_confidence",
        "recovery_rerank",
        "recovery_no_rerank",
        "no_rerank",
        "rerank_failed"
      ],
      "cases": [
        {
          "name": "agreement+margin → high",
          "signals": {
            "candidate_count": 40,
            "agreement": 0.7,
            "top_margin": 0.2,
            "target_coverage": null,
            "targets_requested": false,
            "targets_resolved": false
          },
          "level": "high"
        },
        {
          "name": "agreement but flat top → medium",
          "signals": {
            "candidate_count": 40,
            "agreement": 0.7,
            "top_margin": 0.05,
            "target_coverage": null,
            "targets_requested": false,
            "targets_resolved": false
          },
          "level": "medium"
        },
        {
          "name": "retrievers disagree → low",
          "signals": {
            "candidate_count": 40,
            "agreement": 0.1,
            "top_margin": 0.5,
            "target_coverage": null,
            "targets_requested": false,
            "targets_resolved": false
          },
          "level": "low"
        },
        {
          "name": "too few candidates → low",
          "signals": {
            "candidate_count": 2,
            "agreement": 1.0,
            "top_margin": 1.0,
            "target_coverage": null,
            "targets_requested": false,
            "targets_resolved": false
          },
          "level": "low"
        },
        {
          "name": "person resolved but absent from top → low",
          "signals": {
            "candidate_count": 40,
            "agreement": 0.8,
            "top_margin": 0.3,
            "target_coverage": 0.1,
            "targets_requested": true,
            "targets_resolved": true
          },
          "level": "low"
        },
        {
          "name": "person named but unresolved → medium cap",
          "signals": {
            "candidate_count": 40,
            "agreement": 0.8,
            "top_margin": 0.3,
            "target_coverage": null,
            "targets_requested": true,
            "targets_resolved": false
          },
          "level": "medium"
        },
        {
          "name": "person resolved and covered → high",
          "signals": {
            "candidate_count": 40,
            "agreement": 0.8,
            "top_margin": 0.3,
            "target_coverage": 0.6,
            "targets_requested": true,
            "targets_resolved": true
          },
          "level": "high"
        }
      ],
      "retired": {
        "select_before_search": "2026-09-17 · v1 auto_policy(default/time_scoped/no_rerank_with_signal)는 검색 전에 R0/R1/R2 하나를 골랐다. v2는 후보 관찰 후 결정한다.",
        "heuristic_fallback": "2026-09-17 · R1은 gold v3 n=85에서 R0 대비 −25pp(07 로그). person/recent 신호는 가산이 아니라 scope·candidate source로 옮긴다(R0 v2)."
      }
    },
    "retrieval_state": [
      "not_attempted",
      "candidates",
      "empty_in_allowed_scope",
      "insufficient_authorized_candidates"
    ],
    "memory_requirement": [
      "none",
      "optional",
      "required"
    ],
    "legacy_aliases": {
      "cohere": "rerank",
      "semantic": "rerank"
    },
    "evidence_note": "2026-09-17 ablation n=40 synthetic: R2 R@1 82% MRR .844, R0 70-75%, R1 68-75% (R2 vs R0 worse=0). time_scoped→R2 + recent_window pool (리랭커가 시점을 못 보므로 풀을 먼저 좁힌다). gold 유형 분해는 WP-8."
  },
