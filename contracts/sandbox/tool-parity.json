    "time_kind": [
      "any",
      "recent",
      "today",
      "yesterday",
      "last_week",
      "this_month",
      "before",
      "after",
      "between"
    ],
    "time": {
      "kind": "time_kind 중 하나 (없으면 time_scope에서 유도: recent↔recent, any↔any)",
      "from": "ISO-8601 또는 null (before/after/between 에서만)",
      "to": "ISO-8601 또는 null",
      "rule": "time 은 scope(검색 universe 제한)에만 쓴다. 최근성 점수 가산에는 쓰지 않는다"
    },
    "semantic_query": "질문의 의미를 풀어 쓴 검색 문장(≤300자). dense 검색의 2번째 질의. 없으면 원문만 쓴다",
    "key_terms": "핵심 명사·고유명사 ≤12개. lexical 검색의 2번째 질의. 없으면 생략"
